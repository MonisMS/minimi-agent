# Server-only secrets. Copy to .env for local use; never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=
TAVILY_API_KEY=

PORT=3000
DATA_DIR=./data

# Runtime input limits (defaults shown).
MAX_MODEL_CALLS=4
MAX_SEARCH_QUERIES=12
MAX_SEARCH_BATCHES=3
SEARCH_CONCURRENCY=3
MAX_RUN_MS=120000
ACQUISITION_CUTOFF_MS=100000
ACTIVE_RUN_PER_CONVERSATION=1
PROCESS_ACTIVE_RUNS=2
